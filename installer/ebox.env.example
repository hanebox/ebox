# ebox environment. The installer writes this file to /etc/ebox/ebox.env
# (mode 0600) with the values you chose.
#
# APP_KEY encrypts stored secrets. The installer generates one and preserves it
# on upgrade; changing it makes existing secrets unreadable.
APP_KEY=
APP_ENV=production
APP_DEBUG=false

# The Go server binds APP_HOST/APP_PORT. EBOX_HOST/EBOX_PORT feed proxy routing
# and the URLs the panel shows.
APP_HOST=127.0.0.1
APP_PORT=8000
EBOX_HOST=127.0.0.1
EBOX_PORT=8000

# Database, app checkouts, volumes, backups and the Traefik stack.
EBOX_DATA_DIR=/var/lib/ebox
EBOX_TRAEFIK_DIR=/var/lib/ebox/traefik
EBOX_DOCKER_NETWORK=ebox

# Local port the Traefik API is published on.
EBOX_TRAEFIK_API_PORT=8080

# GitHub repository used for release checks and self-update.
EBOX_UPDATE_REPOSITORY=buildandbuild/ebox
