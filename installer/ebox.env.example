# ebox environment. Installed to /etc/ebox/ebox.env (mode 0600).
#
# APP_KEY encrypts stored secrets. The installer generates one; changing it
# makes existing secrets unreadable.
APP_KEY=
APP_ENV=production
APP_DEBUG=false

# Where the panel keeps its database, app checkouts, volumes and backups.
EBOX_DATA_DIR=/var/lib/ebox

# Address the panel listens on. Put it behind the bundled proxy or your own.
EBOX_HOST=127.0.0.1
EBOX_PORT=8000

EBOX_DOCKER_NETWORK=ebox

# Local port the Traefik API is published on.
EBOX_TRAEFIK_API_PORT=8080

# GitHub repository used for release checks and self-update.
EBOX_UPDATE_REPOSITORY=buildandbuild/ebox
